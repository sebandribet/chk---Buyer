# Copiar a .env y completar. .env está en .gitignore: nunca commitear la key.
OPENAI_API_KEY=

# Verificar contra qué modelo tenemos créditos antes de grabar fixtures.
# Tiene que soportar structured outputs (response_format json_schema, strict).
OPENAI_MODEL=gpt-4o

# Dejalo SIN definir: con la key presente, el demo y la UI salen en `live`, que
# es el único modo que responde un prompt que nadie grabó — o sea, la trial by
# fire. Los tests fuerzan `replay` por su cuenta desde vitest.config.ts.
# Valores posibles: replay | record | live
# LLM_MODE=

# Stripe, en TEST MODE. La key `sk_test_...` sale del dashboard, en
# Developers → API keys. Sin esto la demo de pagos corre igual, con el
# proveedor en memoria — y ese modo offline es a propósito: el sistema se
# juzga con los jueces operándolo en vivo, y no puede depender del wifi.
STRIPE_SECRET_KEY=

# Un PaymentMethod de prueba ya creado (`pm_...`). Contra Stripe de verdad hace
# falta uno: el humano carga la tarjeta UNA vez con la Payment Element y de ahí
# en adelante el agente sólo ve este token, nunca el número.
# STRIPE_PM=pm_card_visa
# STRIPE_PM_DECLINED=pm_card_visa_chargeDeclined
