{
  "name": "agentic-buyer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente comprador: prompt -> discover -> decide. NextWave Challenge 1 (Yuno).",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ui": "tsx --env-file-if-exists=../.env ../src/cli/server.ts",
    "demo": "tsx --env-file-if-exists=.env src/cli/demo.ts",
    "demo:mandate": "tsx src/cli/mandate-demo.ts",
    "record": "LLM_MODE=record tsx --env-file-if-exists=.env src/cli/record.ts",
    "scrape": "tsx --env-file-if-exists=.env src/cli/scrape.ts",
    "demo:stripe": "tsx --env-file-if-exists=.env src/cli/stripe-demo.ts"
  },
  "dependencies": {
    "openai": "^4.77.0",
    "stripe": "^22.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
