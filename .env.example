# Keep this file key-free. Copy it to .env (ignored by git) and add your key.
OPENAI_API_KEY=

# Override only if you want a different model. It must support structured
# outputs (response_format json_schema, strict).
OPENAI_MODEL=gpt-4o

# Leave this UNSET. With a key present the agent runs in `live`, which answers
# a rehearsed prompt from a fixture and calls the model for anything else -
# the demo needs to survive a question nobody rehearsed. With no key it falls
# back to `replay`, so a fresh checkout still runs.
# The tests never read this: they script the model directly.
# Values: replay | record | live
# LLM_MODE=
